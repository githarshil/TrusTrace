# Tip Autopsy — Root Environment Example
# Copy frontend/.env.example -> frontend/.env and backend/.env.example -> backend/.env
# Never commit real secrets or service-role keys.

# Frontend (public client variables only — NEVER put secrets here)
VITE_API_BASE_URL=http://localhost:8000

# Backend (server-side only)
APP_ENV=development
NODE_ENV=development
PORT=8000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase PostgreSQL (server-side only)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-side-service-role-key
DATABASE_URL=postgresql://postgres:replace-with-password@db.your-project-ref.supabase.co:5432/postgres

# Optional bounded multimodal/LLM parser (server-side only; supports free Gemini / Groq tiers or disabled fallback)
LLM_PROVIDER=disabled
LLM_API_KEY=

# Optional Sarvam voice readout (server-side only)
SARVAM_API_KEY=

# Phase 4: Zero-cost real-time market data (Yahoo Finance NSE/BSE v8 API + snapshot fallback)
LIVE_MARKET_ENABLED=true
LIVE_MARKET_CACHE_TTL_MS=45000

# Phase 4: Real-time YouTube Atom RSS / WebSub monitor & WhatsApp alerts (Twilio / CallMeBot / Meta Cloud / Dry-Run)
YOUTUBE_MONITOR_ENABLED=true
YOUTUBE_POLL_INTERVAL_MS=180000
WHATSAPP_PROVIDER=dry_run
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
SUBSCRIPTION_ENCRYPTION_KEY=replace-with-32-byte-hex-or-random-secret
INTERNAL_CRON_SECRET=

# Phase 7: Social Signal Intelligence optional official API connectors (server-side only; zero scraping)
YOUTUBE_DATA_API_KEY=
X_BEARER_TOKEN=
